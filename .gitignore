# Harvester output. Regenerated by `npm run manuals:harvest`, reviewed by
# a person, then folded into data/manuals/<manufacturer>.json by hand.
# Candidates are not catalogue records and should not be committed.
data/manuals/harvested/

# Agent working memory (.agents/memory) is committed on purpose — it is
# how context survives between sessions. Rendered output is not: page
# images and similar artefacts are derived from source already in the
# repo, and 64 of them had grown to dominate the checkout.
.agents/outputs/
