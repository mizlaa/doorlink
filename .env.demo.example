# Demo build. Copy to .env.demo (or export these) and keep it out of git.
# Demo mode refuses to start unless DATABASE_URL names a database containing "demo".
DOORLINK_DEMO=true
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/doorlink_demo?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/doorlink_demo?schema=public"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Leave every provider key unset in demo mode. Payments, AI images, email and
# uploads are simulated, and none of these keys are ever used.
