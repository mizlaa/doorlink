# Replit configuration — npm + Next.js 15. See WORKFLOW.md and replit.md.
#
# GitHub Import is NOT safe: when package.json depends on `next`, Replit
# auto-starts Agent "Port imported Vercel app". Attach with a Blank Repl
# and git instead (WORKFLOW.md — Setting up a fresh Repl).

run = "npm run dev -- --hostname 0.0.0.0 --port $PORT"
entrypoint = "src/app/page.tsx"
modules = ["nodejs-22", "postgresql-16", "python-base-3.13"]

hidden = [".next", "node_modules", ".git"]

[nix]
channel = "stable-24_05"
packages = ["freetype", "gumbo", "harfbuzz", "jbig2dec", "libjpeg_turbo", "mupdf", "openjpeg", "swig", "xcbuild"]

[env]
PORT = "3000"

[deployment]
build = ["sh", "-c", "npm install && npm run build"]
run = ["sh", "-c", "npm run start -- --hostname 0.0.0.0 --port $PORT"]
deploymentTarget = "gce"
ignorePorts = false

[[ports]]
localPort = 5000
externalPort = 80

[gitHubImport]
requiredFiles = [".replit", "package.json", "next.config.mjs"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev -- --hostname 0.0.0.0 --port 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
