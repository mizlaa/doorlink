# ---- Database (required) ----
DATABASE_URL="postgresql://user:password@localhost:5432/doorlink?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/doorlink?schema=public"

# ---- Auth (required before login works) ----
AUTH_SECRET=""
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ---- Storage: documents, product images (optional until uploads are enabled) ----
SUPABASE_STORAGE_BUCKET="doorlink-documents"

# ---- Payments: marketplace checkout (optional; checkout stays in "not connected" mode without it) ----
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_CONNECT_CLIENT_ID=""
# Stripe Connect webhook (events from businesses' accounts: job payments,
# refunds, disputes, onboarding). Endpoint: /api/webhooks/stripe-connect,
# listening to "Connected accounts" events.
STRIPE_CONNECT_WEBHOOK_SECRET=""
# Daily job housekeeping (auto-completes finished jobs): GET /api/cron/jobs
# with "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=""

# Hourly: appointment reminders and rate-limit cleanup: GET /api/cron/reminders
# with the same "Authorization: Bearer $CRON_SECRET".

# ---- Email / notifications (optional) ----
RESEND_API_KEY=""
# Resend webhook (delivered/bounced for invoice emails). Endpoint:
# /api/webhooks/resend, events email.delivered, email.bounced, email.complained.
RESEND_WEBHOOK_SECRET=""

# ---- Push notifications (optional; generate a VAPID pair, no provider needed) ----
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
EMAIL_FROM="no-reply@doorlink.example"

# ---- AI features (optional; Module 26) ----
ANTHROPIC_API_KEY=""

# ---- Door photo preview on /configure (optional; OpenAI test key only) ----
OPENAI_API_KEY=""

# ---- Security ----
# Encrypts two-step sign-in secrets at rest (falls back to AUTH_SECRET). Keep it
# stable: changing it means everyone sets up two-step sign-in again.
MFA_ENCRYPTION_KEY=""
# How many proxies in front of the app append to X-Forwarded-For (check the
# host's docs). Set it so rate limits key on the real client address.
TRUSTED_PROXY_HOPS=""

# ---- Platform ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
DOORLINK_DEMO_MODE="true"
