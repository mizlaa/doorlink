# ---- Database (required) ----
DATABASE_URL="postgresql://user:password@localhost:5432/doorlink?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/doorlink?schema=public"

# ---- Auth (required before login works) ----
AUTH_SECRET=""
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ---- Storage: documents, product images (optional until uploads are enabled) ----
SUPABASE_STORAGE_BUCKET="doorlink-documents"

# ---- Payments: marketplace checkout (optional; checkout stays in "not connected" mode without it) ----
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_CONNECT_CLIENT_ID=""

# ---- Email / notifications (optional) ----
RESEND_API_KEY=""

# ---- Push notifications (optional; generate a VAPID pair, no provider needed) ----
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
EMAIL_FROM="no-reply@doorlink.example"

# ---- AI features (optional; Module 26) ----
ANTHROPIC_API_KEY=""

# ---- Door photo preview on /configure (optional; OpenAI test key only) ----
OPENAI_API_KEY=""

# ---- Platform ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
DOORLINK_DEMO_MODE="true"
