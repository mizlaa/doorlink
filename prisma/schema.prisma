// DoorLink — relational schema.
// Provenance is a first-class concern: every catalogue record carries a
// DataSource so the UI can render an honest caution badge instead of
// pretending demo or imported data is verified (brief rules 28, 35).
// Money is stored as integer minor units throughout — no float drift in
// a multi-vendor marketplace.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------

enum Role {
  CUSTOMER
  TECHNICIAN
  SUPPLIER
  MANUFACTURER
  ADMIN
}

enum OrgType {
  SUPPLIER
  MANUFACTURER
  TECHNICIAN_COMPANY
}

enum OrgMemberRole {
  OWNER
  STAFF
}

// Where a catalogue record actually came from. Rendered by <SourceBadge />
// wherever the record appears — never inferred, never hidden.
enum DataSource {
  DEMO
  MANUFACTURER_VERIFIED
  ADMIN_VERIFIED
  COMMUNITY_SUBMITTED
  IMPORTED
}

enum DocumentKind {
  INSTALL_MANUAL
  USER_MANUAL
  WIRING_DIAGRAM
  PARTS_LIST
  SPEC_SHEET
  WARRANTY
  SERVICE_BULLETIN
  PROGRAMMING_GUIDE
  TROUBLESHOOTING_GUIDE
  TECHNICAL_DOCUMENT
  SAFETY_DOCUMENT
  QUICK_START
  DECLARATION_OF_CONFORMITY
}

// Where a document physically came from, kept separate from DataSource
// (which describes how much we trust the *catalogue record*). A manual
// scraped off an installer's website is a real, useful document even
// though it is not the manufacturer's own file — conflating the two
// would let third-party content present itself as official.
enum DocumentOrigin {
  MANUFACTURER_ORIGINAL
  THIRD_PARTY_GUIDE
  COMMUNITY_CONTRIBUTED
  DOORLINK_AUTHORED
  UNKNOWN
}

enum CompatibilityKind {
  REPLACEMENT_PART
  ACCESSORY
  REMOTE_PAIR
  CONTROL_BOARD_MATCH
  MOTOR_MATCH
}

enum CompatibilityConfidence {
  CONFIRMED
  LIKELY
  UNCONFIRMED
}

enum ListingCondition {
  NEW
  REFURBISHED
  USED
}

enum ListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  SOLD_OUT
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  FULFILLING
  PARTIALLY_SHIPPED
  SHIPPED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum OrderItemStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  CLOSED
  OPEN_FOR_QUOTES
  QUOTED
  ASSIGNED
  EXPIRED
  CANCELLED
}

enum JobStatus {
  REQUESTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ACCEPTED
  AWAITING_PAYMENT
  DISPUTED
}

enum UrgencyLevel {
  EMERGENCY
  URGENT
  STANDARD
  FLEXIBLE
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
  EXPIRED
}

enum VerificationStatus {
  UNVERIFIED
  SUBMITTED
  IN_REVIEW
  VERIFIED
  REJECTED
}

enum TransactionStatus {
  PENDING
  REQUIRES_ACTION
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum PayoutStatus {
  PENDING
  SCHEDULED
  PAID
  FAILED
  CANCELLED
}

enum SubscriptionStatus {
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum BillingInterval {
  WEEK
  MONTH
  YEAR
}

enum DisputeStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  ACTIONED
  DISMISSED
}

enum ReportTargetType {
  USER
  LEAD
  JOB
  MESSAGE
  LISTING
  REVIEW
}

enum SupportStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum SupportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationType {
  ORDER_UPDATE
  LEAD_ASSIGNED
  DOCUMENT_UPDATED
  SUPPORT_REPLY
  SYSTEM
  LEAD_MATCHED
  QUOTE_RECEIVED
  QUOTE_ACCEPTED
  QUOTE_DECLINED
  JOB_SCHEDULED
  JOB_REMINDER
  JOB_COMPLETED
  MESSAGE_RECEIVED
  PAYMENT_STATUS
  PAYOUT_STATUS
  SUBSCRIPTION_STATUS
  REVIEW_RECEIVED
  VERIFICATION_STATUS
}

// Which market a document was published for. A US opener manual and its
// Australian counterpart differ in wiring, voltage and compliance text,
// so "there is a manual for this model" is not the same claim as "there
// is a manual for this model here".
enum Region {
  AU
  NZ
  UK
  US
  CA
  EU
  ASIA
  GLOBAL
  UNKNOWN
}

// Whether Doorlink may host a copy of a document, as opposed to linking
// to it. Decided per document and never inferred from the fact that a
// file happened to be downloadable — publicly reachable and free to
// redistribute are different things.
enum DocumentRights {
  // Link to the manufacturer's copy. The safe default.
  LINK_ONLY
  // The publisher grants redistribution, recorded in rightsNote.
  REDISTRIBUTABLE
  // Doorlink wrote it.
  OWN_CONTENT
  // Someone needs to look at this before it is shown.
  UNCLEAR
}

// The outcome of actually requesting the document's URL. Never guessed.
enum VerificationState {
  // Nobody has checked. Not a claim that the link is broken.
  UNVERIFIED
  // Fetched, and the response was the expected document.
  REACHABLE
  // Fetched, and the server said it is gone.
  BROKEN
  // Fetched, but it moved; the new location is recorded.
  REDIRECTED
  // Behind a login, a paywall or a portal. Recorded and left alone —
  // Doorlink does not attempt to get past any of those.
  RESTRICTED
}

// How much authority an alternate source carries, kept separate from
// DocumentOrigin so "the manufacturer's own site" and "a reseller who
// mirrors the PDF" cannot be presented as the same thing.
enum SourceAuthority {
  MANUFACTURER_OFFICIAL
  AUTHORISED_DISTRIBUTOR
  THIRD_PARTY_MIRROR
  UNKNOWN
}

enum ImportJobStatus {
  PENDING
  VALIDATING
  STAGED
  APPLIED
  REJECTED
}

enum ImportRowStatus {
  PENDING
  VALID
  INVALID
  APPLIED
}

// ---------------------------------------------------------------------
// Identity and organisations
// ---------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      Role     @default(CUSTOMER)
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships       OrganizationMember[]
  technicianProfile TechnicianProfile?
  addresses         Address[]
  cart              Cart?
  orders            Order[]              @relation("OrderBuyer")
  reviews           Review[]
  favorites         Favorite[]
  listings          Listing[]
  assignedLeads     Lead[]
  jobs              Job[]                @relation("JobCustomer")
  supportTickets    SupportTicket[]
  supportMessages   SupportMessage[]
  notifications     Notification[]
  auditLogs         AuditLog[]

  requestedLeads         Lead[]                    @relation("LeadCustomer")
  quotes                 Quote[]                   @relation("QuoteWorker")
  workerJobs             Job[]                     @relation("JobWorker")
  jobStatusEvents        JobStatusEvent[]
  conversations          ConversationParticipant[]
  messages               Message[]
  reviewsWritten         WorkerReview[]            @relation("ReviewAuthor")
  reviewsReceived        WorkerReview[]            @relation("ReviewSubject")
  transactionsAsCustomer Transaction[]             @relation("TransactionCustomer")
  transactionsAsWorker   Transaction[]             @relation("TransactionWorker")
  payouts                Payout[]                  @relation("PayoutWorker")
  subscriptions          Subscription[]
  savedManuals           SavedManual[]
  doorConfigurations     DoorConfiguration[]
  disputesRaised         Dispute[]                 @relation("DisputeRaiser")
  reportsFiled           Report[]                  @relation("ReportAuthor")
  complianceProfile      ComplianceProfile?
  compliancePurchases    CompliancePackPurchase[]
  reportsReviewed        Report[]                  @relation("ReportReviewer")

  clientRecords          Client[]                  @relation("ClientUser")
  inspections            Inspection[]              @relation("InspectionTechnician")
  inspectionStatusEvents InspectionStatusEvent[]   @relation("InspectionStatusActor")
  evidenceCaptured       InspectionEvidence[]      @relation("EvidenceCapturedBy")
  actionsAssigned        CorrectiveAction[]        @relation("ActionAssignee")
  actionsVerified        CorrectiveAction[]        @relation("ActionVerifier")
  inspectionReports      InspectionReportVersion[] @relation("ReportGeneratedBy")
  submittedManuals       ManualSubmission[]        @relation("SubmittedManuals")
  reviewedManuals        ManualSubmission[]        @relation("ReviewedManuals")
  manualSubmissionEvents ManualSubmissionEvent[]   @relation("ManualSubmissionEvents")
  springCalculations     SpringCalculation[]       @relation("SpringCalculations")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  type      OrgType
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members         OrganizationMember[]
  supplierProfile SupplierProfile?
  manufacturer    Manufacturer?
  listings        Listing[]
  orderItems      OrderItem[]
  jobs            Job[]                @relation("JobOrganization")
  leads           Lead[]
  importJobs      ImportJob[]

  clients             Client[]
  sites               Site[]
  assets              Asset[]
  inspectionTemplates InspectionTemplate[]
  inspections         Inspection[]
  correctiveActions   CorrectiveAction[]
}

model OrganizationMember {
  id             String        @id @default(cuid())
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  role           OrgMemberRole @default(STAFF)
  createdAt      DateTime      @default(now())

  @@unique([organizationId, userId])
}

// The worker/technician side of the marketplace. `verified` stays a
// plain boolean set by an admin — it means "a Doorlink admin checked the
// supplied documents", never "a licensing authority confirmed this",
// which would require an integration that does not exist. The
// verificationStatus field tracks where in that manual process a worker
// sits.
model TechnicianProfile {
  id                 String             @id @default(cuid())
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String             @unique
  verified           Boolean            @default(false)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  verificationNote   String?
  verifiedAt         DateTime?

  businessName    String?
  // The number a technician puts on the side of the van, which is often
  // not the number on their personal account record.
  businessPhone   String?
  abn             String?
  avatarUrl       String?
  headline        String?
  bio             String?
  yearsExperience Int?

  licenceNumber         String?
  insurerName           String?
  insurancePolicyNumber String?
  insuranceExpiresAt    DateTime?

  serviceArea     String?
  baseSuburb      String?
  baseState       String?
  basePostcode    String?
  serviceRadiusKm Int?

  hourlyRateCents Int?
  calloutFeeCents Int?
  currency        String @default("AUD")

  acceptingWork Boolean @default(true)

  // Denormalised rating cache, recomputed whenever a review lands.
  // Kept on the row because worker lists sort and filter on it, and
  // aggregating every review per card on every browse page would not
  // hold up.
  ratingAvg     Float?
  ratingCount   Int    @default(0)
  jobsCompleted Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs           Job[]                 @relation("JobTechnician")
  services       WorkerService[]
  serviceAreas   WorkerServiceArea[]
  availability   WorkerAvailability[]
  certifications WorkerCertification[]
}

model WorkerService {
  id             String            @id @default(cuid())
  worker         TechnicianProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  workerId       String
  category       ServiceCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId     String
  fromPriceCents Int?
  note           String?
  createdAt      DateTime          @default(now())

  @@unique([workerId, categoryId])
}

model WorkerServiceArea {
  id        String            @id @default(cuid())
  worker    TechnicianProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  workerId  String
  suburb    String?
  state     String?
  postcode  String
  createdAt DateTime          @default(now())

  @@unique([workerId, postcode])
  @@index([postcode])
}

model WorkerAvailability {
  id          String            @id @default(cuid())
  worker      TechnicianProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  workerId    String
  // 0 = Sunday through 6 = Saturday, matching JS getDay().
  dayOfWeek   Int
  startMinute Int
  endMinute   Int
  createdAt   DateTime          @default(now())

  @@unique([workerId, dayOfWeek, startMinute])
}

model WorkerCertification {
  id        String            @id @default(cuid())
  worker    TechnicianProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  workerId  String
  name      String
  issuer    String?
  reference String?
  fileKey   String?
  issuedAt  DateTime?
  expiresAt DateTime?
  // Admin-reviewed, same honesty boundary as TechnicianProfile.verified.
  verified  Boolean           @default(false)
  createdAt DateTime          @default(now())
}

model SupplierProfile {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String       @unique
  commissionBps  Int          @default(0)
  verified       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// ---------------------------------------------------------------------
// Catalogue tree
// ---------------------------------------------------------------------

model Manufacturer {
  id             String        @id @default(cuid())
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?       @unique
  name           String        @unique
  slug           String        @unique
  dataSource     DataSource    @default(DEMO)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Where the company actually is, and where it publishes documents.
  // Recorded so a technician can tell an Australian B&D manual from a
  // same-named product sold elsewhere.
  country    String?
  website    String?
  supportUrl String?

  productLines ProductLine[]
  models       Model[]
  documents    Document[]
}

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  // Explicit Restrict — Prisma's default for an optional relation is
  // SetNull, which would silently orphan subcategories into top-level ones
  // on delete instead of blocking it like every other in-use catalogue
  // relation does.
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  parentId  String?
  children  Category[] @relation("CategoryTree")
  createdAt DateTime   @default(now())

  models    Model[]
  documents Document[]
}

model ProductLine {
  id             String       @id @default(cuid())
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)
  manufacturerId String
  name           String
  slug           String
  dataSource     DataSource   @default(DEMO)
  createdAt      DateTime     @default(now())

  models Model[]

  @@unique([manufacturerId, slug])
}

// The catalogue leaf: an opener, motor, remote, lock, or spare part.
// Every finder cascade ends here.
model Model {
  id             String       @id @default(cuid())
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id])
  manufacturerId String
  category       Category     @relation(fields: [categoryId], references: [id])
  categoryId     String
  productLine    ProductLine? @relation(fields: [productLineId], references: [id])
  productLineId  String?
  name           String
  modelCode      String
  slug           String       @unique
  summary        String?
  dataSource     DataSource   @default(DEMO)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  specs          ModelSpec[]
  documents      Document[]
  listings       Listing[]
  compatibleFrom Compatibility[]     @relation("CompatFrom")
  compatibleTo   Compatibility[]     @relation("CompatTo")
  favorites      Favorite[]
  jobs           Job[]
  leads          Lead[]
  configurations DoorConfiguration[]
  aliases        ModelAlias[]
  assets         Asset[]

  @@unique([manufacturerId, modelCode])
}

model ModelSpec {
  id        String  @id @default(cuid())
  model     Model   @relation(fields: [modelId], references: [id], onDelete: Cascade)
  modelId   String
  label     String
  value     String
  unit      String?
  sortOrder Int     @default(0)
}

// ---------------------------------------------------------------------
// Technical library
// ---------------------------------------------------------------------

// supersedesId forms a revision chain so an old installation keeps its
// correct manual instead of being shown the current one.
// A single document in the manuals library. modelId is optional because
// plenty of real documents (a keypad coding guide, a generic wiring
// sheet) belong to a manufacturer or category without a catalogue Model
// record existing for them yet — requiring one would mean either
// inventing model records or dropping usable documents.
model Document {
  id             String        @id @default(cuid())
  slug           String        @unique
  model          Model?        @relation(fields: [modelId], references: [id], onDelete: Cascade)
  modelId        String?
  manufacturer   Manufacturer? @relation(fields: [manufacturerId], references: [id])
  manufacturerId String?
  category       Category?     @relation(fields: [categoryId], references: [id])
  categoryId     String?
  kind           DocumentKind
  title          String
  description    String?

  // Nullable on purpose. Most manufacturer documentation may be linked
  // to but not rehosted, so the common case is a verified record that
  // points at the manufacturer's own PDF and stores no file at all.
  // A required fileKey made that case impossible to express, which
  // meant the only way to list a manual was to copy it.
  fileKey String?
  version String  @default("1")

  // Printed on the document itself, not invented — a FAAC manual carries
  // a document code (732786) and a revision (Rev.C) which is how the
  // trade actually refers to a specific edition.
  documentCode     String?
  revision         String?
  language         String  @default("en")
  pageCount        Int?
  fileSizeBytes    Int?
  mimeType         String  @default("application/pdf")
  originalFilename String?

  origin         DocumentOrigin @default(UNKNOWN)
  publisher      String?
  sourceUrl      String?
  provenanceNote String?

  // Text extracted from the file at ingest, used for full-text search.
  // Never edited by hand — it is a copy of what the document says, so
  // search results can never claim content the document doesn't contain.
  searchText String?

  dataSource    DataSource @default(DEMO)
  isPublished   Boolean    @default(true)
  downloadCount Int        @default(0)
  publishedAt   DateTime?

  // Where the manufacturer publishes this document for this market. A
  // US opener manual and its Australian equivalent are different
  // documents with different wiring and different compliance text, and
  // handing a technician the wrong one is worse than handing them none.
  region Region @default(UNKNOWN)

  // Whether Doorlink may host a copy, decided per document rather than
  // assumed. LINK_ONLY is the default because it is the assumption that
  // cannot infringe: publicly downloadable is not the same as free to
  // redistribute.
  rights     DocumentRights @default(LINK_ONLY)
  rightsNote String?

  // The result of actually fetching the URL, never inferred. UNVERIFIED
  // means nobody has checked, which is different from checked-and-broken
  // and is displayed differently.
  verification   VerificationState @default(UNVERIFIED)
  lastVerifiedAt DateTime?
  lastHttpStatus Int?
  // Set when a check fails. A document is flagged for review rather than
  // deleted: a manufacturer's site being down for an afternoon is not
  // evidence the manual no longer exists.
  needsReview    Boolean           @default(false)
  reviewReason   String?

  supersedes   Document? @relation("DocumentRevision", fields: [supersedesId], references: [id])
  supersedesId String?   @unique
  supersededBy Document? @relation("DocumentRevision")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  savedBy              SavedManual[]
  altSources           DocumentSource[]
  complianceReferences ComplianceReference[]

  duplicateSubmissions ManualSubmission[] @relation("SubmissionDuplicate")
  sourceSubmission     ManualSubmission?  @relation("SubmissionPublished")

  @@index([manufacturerId])
  @@index([categoryId])
  @@index([modelId])
  @@index([kind])
}

model SavedManual {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String
  note       String?
  createdAt  DateTime @default(now())

  @@unique([userId, documentId])
}

// ---------------------------------------------------------------------
// Compatibility engine — a join table, never hardcoded in a component.
// Queried in both directions via compatibleFrom / compatibleTo.
// ---------------------------------------------------------------------

model Compatibility {
  id          String                  @id @default(cuid())
  fromModel   Model                   @relation("CompatFrom", fields: [fromModelId], references: [id], onDelete: Cascade)
  fromModelId String
  toModel     Model                   @relation("CompatTo", fields: [toModelId], references: [id], onDelete: Cascade)
  toModelId   String
  kind        CompatibilityKind
  confidence  CompatibilityConfidence @default(UNCONFIRMED)
  dataSource  DataSource              @default(DEMO)
  note        String?
  createdAt   DateTime                @default(now())

  @@unique([fromModelId, toModelId, kind])
}

// ---------------------------------------------------------------------
// Marketplace, cart, orders
// ---------------------------------------------------------------------

// A listing is sold by either a business (organizationId) or an
// individual peer-to-peer seller (sellerId) — never neither, enforced in
// the create/update actions rather than at the schema level (Prisma has
// no native "exactly one of two nullable columns" constraint).
model Listing {
  id             String           @id @default(cuid())
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String?
  seller         User?            @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId       String?
  model          Model            @relation(fields: [modelId], references: [id])
  modelId        String
  title          String
  priceCents     Int
  currency       String           @default("AUD")
  condition      ListingCondition @default(NEW)
  status         ListingStatus    @default(DRAFT)
  stockQty       Int              @default(0)
  dataSource     DataSource       @default(DEMO)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]
  reviews    Review[]
}

model Cart {
  id        String     @id @default(cuid())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String     @unique
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String  @id @default(cuid())
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId    String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
  quantity  Int     @default(1)

  @@unique([cartId, listingId])
}

// OrderItem carries its own orgId and status so a multi-vendor basket
// fulfils per seller instead of as one monolithic order.
model Order {
  id                String      @id @default(cuid())
  buyer             User        @relation("OrderBuyer", fields: [buyerId], references: [id])
  buyerId           String
  status            OrderStatus @default(PENDING_PAYMENT)
  totalCents        Int
  currency          String      @default("AUD")
  shippingAddress   Address?    @relation(fields: [shippingAddressId], references: [id])
  shippingAddressId String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  items OrderItem[]
}

model OrderItem {
  id             String          @id @default(cuid())
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId        String
  listing        Listing         @relation(fields: [listingId], references: [id])
  listingId      String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  organizationId String
  quantity       Int
  unitPriceCents Int
  status         OrderItemStatus @default(PENDING)
}

model Address {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  line1     String
  line2     String?
  suburb    String
  state     String
  postcode  String
  country   String   @default("AU")
  createdAt DateTime @default(now())

  orders Order[]
}

model Review {
  id        String   @id @default(cuid())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  rating    Int
  body      String?
  createdAt DateTime @default(now())

  @@unique([listingId, authorId])
}

model Favorite {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  model     Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  modelId   String
  createdAt DateTime @default(now())

  @@unique([userId, modelId])
}

// ---------------------------------------------------------------------
// Leads, jobs, support
// ---------------------------------------------------------------------

// A "request a technician" lead. Deliberately has no requester account
// link (name/email/phone are captured in the form itself) — submitting
// one never requires signing up, matching the low-friction, contact-by-
// email pattern the marketplace already uses. Claimed by either a
// technician's organization (assignedOrgId) or a technician personally
// (assignedUserId) — the same organization-or-individual duality as
// Listing, for the same reason: a technician doesn't need a registered
// business to pick up work.
// A customer's request for work — the entry point to the services
// marketplace. Contact fields stay on the row (rather than only on a
// linked account) because submitting a request has never required
// signing up, and making it require one now would lose the low-friction
// path that already works.
model Lead {
  id         String  @id @default(cuid())
  reference  String  @unique
  customer   User?   @relation("LeadCustomer", fields: [customerId], references: [id])
  customerId String?
  name       String
  email      String
  phone      String?
  title      String?
  message    String

  serviceCategory   ServiceCategory? @relation(fields: [serviceCategoryId], references: [id])
  serviceCategoryId String?

  suburb   String?
  state    String?
  postcode String?

  urgency         UrgencyLevel @default(STANDARD)
  preferredTiming String?
  budgetMinCents  Int?
  budgetMaxCents  Int?
  currency        String       @default("AUD")

  model          Model?        @relation(fields: [modelId], references: [id])
  modelId        String?
  assignedOrg    Organization? @relation(fields: [assignedOrgId], references: [id])
  assignedOrgId  String?
  assignedUser   User?         @relation(fields: [assignedUserId], references: [id])
  assignedUserId String?
  status         LeadStatus    @default(NEW)
  closedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  photos        LeadPhoto[]
  quotes        Quote[]
  jobs          Job[]
  conversations Conversation[]

  @@index([status])
  @@index([serviceCategoryId])
  @@index([postcode])
}

model LeadPhoto {
  id        String   @id @default(cuid())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId    String
  fileKey   String
  caption   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// The service types the marketplace trades in. A table rather than an
// enum so an admin can add "solar gate retrofit" later without a
// migration and a redeploy.
model ServiceCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leads          Lead[]
  workerServices WorkerService[]
}

// A worker's offer against a lead. amountCents is what the customer
// pays; the worker's take and Doorlink's commission are derived from it
// at acceptance time and snapshotted on the Transaction, so a later
// change to the platform commission rate can never silently rewrite the
// economics of a job already agreed.
model Quote {
  id                       String      @id @default(cuid())
  lead                     Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId                   String
  worker                   User        @relation("QuoteWorker", fields: [workerId], references: [id], onDelete: Cascade)
  workerId                 String
  amountCents              Int
  currency                 String      @default("AUD")
  message                  String
  estimatedDurationMinutes Int?
  availableFrom            DateTime?
  validUntil               DateTime?
  status                   QuoteStatus @default(PENDING)
  respondedAt              DateTime?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  job Job?

  @@unique([leadId, workerId])
  @@index([status])
}

model Job {
  id                 String             @id @default(cuid())
  reference          String             @unique
  lead               Lead?              @relation(fields: [leadId], references: [id])
  leadId             String?
  quote              Quote?             @relation(fields: [quoteId], references: [id])
  quoteId            String?            @unique
  technician         TechnicianProfile? @relation("JobTechnician", fields: [technicianId], references: [id])
  technicianId       String?
  worker             User?              @relation("JobWorker", fields: [workerId], references: [id])
  workerId           String?
  organization       Organization?      @relation("JobOrganization", fields: [organizationId], references: [id])
  organizationId     String?
  customer           User?              @relation("JobCustomer", fields: [customerId], references: [id])
  customerId         String?
  model              Model?             @relation(fields: [modelId], references: [id])
  modelId            String?
  description        String
  status             JobStatus          @default(REQUESTED)
  agreedPriceCents   Int?
  currency           String             @default("AUD")
  scheduledAt        DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  statusEvents  JobStatusEvent[]
  transactions  Transaction[]
  workerReview  WorkerReview?
  conversations Conversation[]
  disputes      Dispute[]
  inspections   Inspection[]

  @@index([status])
  @@index([customerId])
  @@index([workerId])
}

// An append-only history of how a job moved through its lifecycle.
// Written alongside every status change so "who moved this to completed,
// and when" is answerable from data rather than inferred from timestamps
// scattered across the Job row.
model JobStatusEvent {
  id         String     @id @default(cuid())
  job        Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId      String
  fromStatus JobStatus?
  toStatus   JobStatus
  actor      User?      @relation(fields: [actorId], references: [id])
  actorId    String?
  note       String?
  createdAt  DateTime   @default(now())

  @@index([jobId])
}

model SupportTicket {
  id        String          @id @default(cuid())
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  subject   String
  status    SupportStatus   @default(OPEN)
  priority  SupportPriority @default(NORMAL)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  messages SupportMessage[]
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId  String
  sender    User          @relation(fields: [senderId], references: [id])
  senderId  String
  body      String
  createdAt DateTime      @default(now())
}

// ---------------------------------------------------------------------
// Notifications, audit log, staged imports, platform settings
// ---------------------------------------------------------------------

model Notification {
  id        String           @id @default(cuid())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      NotificationType
  title     String
  body      String
  // Where the notification is about. A notification you cannot act on is
  // just noise, so almost every one carries the path to the thing that
  // changed.
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actor      User?    @relation(fields: [actorId], references: [id])
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
}

// Nothing reaches the catalogue until an ImportJob is APPLIED — rows are
// staged and validated first.
model ImportJob {
  id             String          @id @default(cuid())
  organization   Organization?   @relation(fields: [organizationId], references: [id])
  organizationId String?
  kind           String
  status         ImportJobStatus @default(PENDING)
  fileKey        String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  rows ImportRow[]
}

model ImportRow {
  id          String          @id @default(cuid())
  importJob   ImportJob       @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  importJobId String
  rowNumber   Int
  rawData     Json
  status      ImportRowStatus @default(PENDING)
  errors      Json?
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// Idempotency record for inbound webhooks (Stripe, Resend, ...).
model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  externalId  String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([provider, externalId])
}

// ---------------------------------------------------------------------
// Messaging
// ---------------------------------------------------------------------

// A thread between a customer and a worker. Optionally bound to the lead
// or job it concerns, so a conversation always has a subject rather than
// floating free — and so a job's whole paper trail can be pulled up in
// one query during a dispute.
model Conversation {
  id            String    @id @default(cuid())
  lead          Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId        String?
  job           Job?      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId         String?
  subject       String?
  lastMessageAt DateTime?
  closedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([leadId])
  @@index([jobId])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  lastReadAt     DateTime?
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderId       String
  body           String
  createdAt      DateTime     @default(now())

  attachments MessageAttachment[]

  @@index([conversationId, createdAt])
}

model MessageAttachment {
  id        String   @id @default(cuid())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String
  fileKey   String
  filename  String?
  mimeType  String?
  sizeBytes Int?
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------

// Tied to a Job, one per job, and only writable once that job is
// actually COMPLETED — a review for work that never happened is the
// single easiest way to make a marketplace's ratings meaningless.
model WorkerReview {
  id              String    @id @default(cuid())
  job             Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId           String    @unique
  author          User      @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  authorId        String
  worker          User      @relation("ReviewSubject", fields: [workerId], references: [id], onDelete: Cascade)
  workerId        String
  rating          Int
  body            String?
  workerReply     String?
  workerRepliedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([workerId])
}

// ---------------------------------------------------------------------
// Payments, commission and payouts
// ---------------------------------------------------------------------

// One money movement for a job. The commission rate is snapshotted here
// (commissionRateBps) rather than read from settings at display time, so
// historical transactions keep reporting the split that was actually
// agreed even after an admin changes the platform rate.
model Transaction {
  id         String  @id @default(cuid())
  reference  String  @unique
  job        Job?    @relation(fields: [jobId], references: [id])
  jobId      String?
  customer   User?   @relation("TransactionCustomer", fields: [customerId], references: [id])
  customerId String?
  worker     User?   @relation("TransactionWorker", fields: [workerId], references: [id])
  workerId   String?

  grossCents        Int
  commissionRateBps Int
  commissionCents   Int
  workerPayoutCents Int
  refundedCents     Int    @default(0)
  currency          String @default("AUD")

  status        TransactionStatus @default(PENDING)
  provider      String?
  providerRef   String?
  // When the provider confirmed the money actually arrived. Null on
  // every transaction that has not been through a verified webhook,
  // which is the only thing that sets it.
  paidAt        DateTime?
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events TransactionEvent[]
  payout Payout?

  @@index([status])
  @@index([jobId])
}

model TransactionEvent {
  id            String      @id @default(cuid())
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionId String
  type          String
  amountCents   Int?
  note          String?
  payload       Json?
  createdAt     DateTime    @default(now())

  @@index([transactionId])
}

model Payout {
  id            String       @id @default(cuid())
  transaction   Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionId String       @unique
  worker        User         @relation("PayoutWorker", fields: [workerId], references: [id])
  workerId      String
  amountCents   Int
  currency      String       @default("AUD")
  status        PayoutStatus @default(PENDING)
  provider      String?
  providerRef   String?
  paidAt        DateTime?
  failureReason String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([workerId])
  @@index([status])
}

// ---------------------------------------------------------------------
// Subscriptions
// ---------------------------------------------------------------------

// Prices live in the database, not in code, because the brief fixes only
// the weekly price ($4.99 AUD) and leaves monthly/annual undecided —
// hard-coding a guess for those would bake a made-up number into the
// product.
model SubscriptionPlan {
  id            String          @id @default(cuid())
  code          String          @unique
  name          String
  description   String?
  interval      BillingInterval
  priceCents    Int?
  currency      String          @default("AUD")
  trialDays     Int?
  features      Json?
  isActive      Boolean         @default(true)
  sortOrder     Int             @default(0)
  // Filled in once Stripe exists; null means this plan cannot be
  // subscribed to yet, and the UI says exactly that.
  stripePriceId String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                     String             @id @default(cuid())
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                 String
  plan                   SubscriptionPlan   @relation(fields: [planId], references: [id])
  planId                 String
  status                 SubscriptionStatus @default(INCOMPLETE)
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  cancelledAt            DateTime?
  provider               String?
  providerCustomerId     String?
  providerSubscriptionId String?            @unique
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([userId])
  @@index([status])
}

// ---------------------------------------------------------------------
// Configurator
// ---------------------------------------------------------------------

model DoorConfiguration {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String?
  name      String
  // The chosen options as a JSON document. Deliberately schemaless: the
  // option set will change as real product data arrives, and a rigid
  // column per option would need a migration every time a finish is
  // added.
  spec      Json
  model     Model?   @relation(fields: [modelId], references: [id])
  modelId   String?
  shareSlug String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ---------------------------------------------------------------------
// Trust and safety
// ---------------------------------------------------------------------

model Dispute {
  id         String        @id @default(cuid())
  job        Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId      String
  raisedBy   User          @relation("DisputeRaiser", fields: [raisedById], references: [id])
  raisedById String
  reason     String
  detail     String?
  status     DisputeStatus @default(OPEN)
  resolution String?
  resolvedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([status])
}

model Report {
  id           String           @id @default(cuid())
  reporter     User             @relation("ReportAuthor", fields: [reporterId], references: [id], onDelete: Cascade)
  reporterId   String
  targetType   ReportTargetType
  targetId     String
  reason       String
  detail       String?
  status       ReportStatus     @default(OPEN)
  reviewedBy   User?            @relation("ReportReviewer", fields: [reviewedById], references: [id])
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime         @default(now())

  @@index([status])
  @@index([targetType, targetId])
}

// ---------------------------------------------------------------------
// Compliance & Safety Pack
//
// A paid add-on: fifteen templates for the door, gate and shutter trade,
// branded with the buyer's own business details and logo.
//
// The business details live here once rather than being re-entered on
// every document, which is the same reasoning the source pack gives for
// completing DL-BUS-001 first: every other document repeats the block.
// ---------------------------------------------------------------------

enum CompliancePurchaseStatus {
  // Created, awaiting a payment provider that has not been connected.
  PENDING
  PAID
  REFUNDED
  CANCELLED
}

model ComplianceProfile {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  // Section 01 — business details
  businessName    String?
  tradingName     String?
  abn             String?
  acn             String?
  businessAddress String?
  postalAddress   String?
  phone           String?
  mobile          String?
  email           String?
  website         String?

  // Section 02 — key people
  ownerName              String?
  operationsManager      String?
  complianceContact      String?
  primarySiteContact     String?
  emergencyContactName   String?
  emergencyContactNumber String?
  firstAidOfficer        String?

  // Section 03 — jurisdiction, licences and insurance
  state                   String?
  whsRegulator            String?
  tradeLicenceNumber      String?
  electricalLicenceNumber String?
  otherRegistration       String?
  publicLiabilityInsurer  String?
  publicLiabilityPolicy   String?
  publicLiabilityExpiry   DateTime?
  workersCompPolicy       String?
  workersCompExpiry       DateTime?

  // Branding. A data URI rather than a storage key: a logo is small, and
  // no file-storage backend is connected. Size and type are validated
  // before this is written — see lib/compliance/logo.ts.
  logoDataUri String?

  // Approval block, repeated on every document
  preparedByName     String?
  preparedByPosition String?
  approvedByName     String?
  approvedByPosition String?

  packVersion String?
  dateIssued  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompliancePackPurchase {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // Doorlink's own reference, handed to the payment provider.
  reference String @unique

  // The price is snapshotted at purchase, for the same reason the
  // commission rate is snapshotted onto a Transaction: changing the list
  // price later must not rewrite what someone was charged.
  priceCents Int
  currency   String @default("AUD")

  status           CompliancePurchaseStatus @default(PENDING)
  providerIntentId String?
  purchasedAt      DateTime?
  refundedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}

// ---------------------------------------------------------------------
// Manual library: aliases and alternate sources
// ---------------------------------------------------------------------

// The same model is written a dozen ways: MT60, MT-60, MT 60, mt60, and
// whatever the installer typed on the job sheet. An alias row lets a
// search match any of them without ever changing the manufacturer's own
// designation, which is what the result page must display (brief §17).
model ModelAlias {
  id      String @id @default(cuid())
  model   Model  @relation(fields: [modelId], references: [id], onDelete: Cascade)
  modelId String

  // As a human would write it.
  alias      String
  // Case- and separator-stripped, which is what queries match against.
  normalised String

  // Where the alias came from: a manufacturer's own alternate spelling,
  // a distributor's catalogue, or a pattern Doorlink generated.
  source    String?
  createdAt DateTime @default(now())

  @@unique([modelId, normalised])
  @@index([normalised])
}

// The same manual is mirrored across resellers and manual sites. Rather
// than storing the document fifteen times, one canonical Document keeps
// the most authoritative source and the rest hang off it here (§8).
model DocumentSource {
  id         String   @id @default(cuid())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String

  url       String
  authority SourceAuthority @default(UNKNOWN)
  label     String?

  verification   VerificationState @default(UNVERIFIED)
  lastVerifiedAt DateTime?
  lastHttpStatus Int?

  createdAt DateTime @default(now())

  @@unique([documentId, url])
  @@index([documentId])
}

// ---------------------------------------------------------------------
// Inspection engine
//
// A technician company's own asset register and the inspections carried
// out against it. Deliberately separate from Lead/Job: those are
// marketplace transactions between two parties, while an Asset is a
// piece of equipment with a service life that outlives any one job, and
// its inspection history is the thing that makes a recurring defect
// visible. An Inspection may reference a Job, but never depends on one.
//
// Everything here is scoped to an Organization. That scope is the
// isolation boundary — a query that forgets it leaks one company's
// customer list to another, so reads go through the helpers in
// src/lib/inspections/scope.ts rather than hand-written where clauses.
// ---------------------------------------------------------------------

enum AssetType {
  ROLLER_SHUTTER
  SECTIONAL_DOOR
  GARAGE_DOOR
  AUTOMATIC_GATE
  SLIDING_GATE
  SWING_GATE
  INDUSTRIAL_DOOR
  MANUAL_DOOR
  OTHER
}

enum InspectionStatus {
  DRAFT
  IN_PROGRESS
  AWAITING_REVIEW
  COMPLETED
  CANCELLED
}

// The headline outcome. Deliberately not a percentage: a door with a
// dead emergency stop is not "92% safe". A numeric score may be
// computed alongside this, but never instead of it.
enum InspectionResult {
  PASS
  ATTENTION_REQUIRED
  FAILED
  INCOMPLETE
}

// How a technician answered the pass/fail axis of a question.
// NOT_TESTED is distinct from NOT_APPLICABLE on purpose: "this door has
// no safety edge" and "I could not test the safety edge" mean opposite
// things to whoever reads the report.
enum AnswerStatus {
  PASS
  FAIL
  NOT_APPLICABLE
  NOT_TESTED
}

enum QuestionType {
  YES_NO
  YES_NO_NA
  PASS_FAIL
  PASS_FAIL_NA
  OBSERVATION
  SINGLE_SELECT
  MULTI_SELECT
  TEXT
  NUMBER
  MEASUREMENT
  DATE
  TIME
  PHOTO
  VIDEO
  SIGNATURE
  CHECKBOX
  DROPDOWN
  SEARCHABLE_DROPDOWN
}

// Technician assessment of how serious an observation is. This is an
// engineering judgement recorded by a person — it is never, on its own,
// a statement that a law has been broken. Regulatory interpretation
// lives in ComplianceReference and is rendered as a separate, sourced
// claim (brief §13).
enum FindingSeverity {
  INFO
  OBSERVATION
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ActionStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  VERIFIED
  CLOSED
}

enum EvidenceKind {
  PHOTO
  VIDEO
  SIGNATURE
  DOCUMENT
}

// A technician company's client. Distinct from User(role: CUSTOMER):
// that is someone with a Doorlink login, whereas most clients in an
// inspection round are a business name and a site contact who will
// never sign in. Linking the two is optional and does not change who
// owns the record.
model Client {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  name           String
  contactName    String?
  email          String?
  phone          String?
  notes          String?

  // Set when this client also holds a Doorlink account, so the customer
  // report view can be shown to them. Null is the normal case.
  user   User?   @relation("ClientUser", fields: [userId], references: [id])
  userId String?

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  sites       Site[]
  assets      Asset[]
  inspections Inspection[]

  @@index([organizationId, name])
  @@index([userId])
}

model Site {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId       String

  name         String
  addressLine  String?
  suburb       String?
  state        String?
  postcode     String?
  contactName  String?
  contactPhone String?
  notes        String?

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  assets      Asset[]
  inspections Inspection[]

  @@index([organizationId])
  @@index([clientId])
}

// A single piece of equipment with a service life. The asset — not the
// inspection — is what carries history, which is what lets Doorlink say
// "this was also reported in June" from stored data rather than a guess.
model Asset {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId       String
  site           Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId         String

  // Human-readable, printed on the report and stuck on the door:
  // DL-ASSET-7F3K2QX. Not the cuid.
  reference String    @unique
  name      String
  assetType AssetType
  location  String?

  // Identification as found on the equipment. Nullable throughout
  // because a 20-year-old shutter frequently has no legible plate, and
  // recording "unknown" honestly beats inventing a serial number.
  serialNumber     String?
  manufacturerName String?
  modelName        String?
  installedAt      DateTime?
  approximateAge   String?

  // Optional link into the Doorlink catalogue when the equipment is a
  // model the platform already knows. Advisory only — an asset is never
  // blocked on the catalogue having an entry.
  catalogueModel   Model?  @relation(fields: [catalogueModelId], references: [id])
  catalogueModelId String?

  // Answers to the asset-type-specific configuration step (drive type,
  // safety devices fitted, control method…). Json because the fields
  // differ per asset type and are admin-editable in the template
  // builder; the shape is validated in src/lib/inspections.
  configuration Json?

  notes      String?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  inspections        Inspection[]
  actions            CorrectiveAction[]
  springCalculations SpringCalculation[]

  @@index([organizationId])
  @@index([siteId])
  @@index([clientId])
  @@index([assetType])
}

// ---------------------------------------------------------------------
// Templates — the inspection engine's content, held as data
//
// Questions live in the database rather than in a checklist component so
// an admin can add one without a migration and a redeploy, and so an
// inspection can record which version of a template it was carried out
// against. A published template is never edited in place: changing the
// wording of a question after an inspection cited it would rewrite what
// a technician was asked, which is exactly the kind of quiet history
// change a report has to be able to rule out.
// ---------------------------------------------------------------------

model InspectionTemplate {
  id             String        @id @default(cuid())
  // Null for Doorlink-supplied templates available to every company; set
  // when a company writes its own.
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String?

  name        String
  slug        String
  description String?

  // Which equipment this template is offered for. A template with an
  // empty list is generic and offered for any asset, which is what
  // AssetType.OTHER falls back to.
  assetTypes AssetType[]

  // Bumped on every publish. An Inspection stores the number it ran
  // against so an old report stays readable as the template moves on.
  version Int @default(1)

  publishedAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sections    TemplateSection[]
  inspections Inspection[]

  @@unique([organizationId, slug, version])
  @@index([organizationId])
}

model TemplateSection {
  id         String             @id @default(cuid())
  template   InspectionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId String

  title       String
  description String?
  sortOrder   Int     @default(0)

  // Narrows a section to particular equipment within a template that
  // otherwise applies broadly. Empty means "every asset this template
  // covers".
  assetTypes AssetType[]

  questions TemplateQuestion[]

  @@index([templateId])
}

model TemplateQuestion {
  id        String          @id @default(cuid())
  section   TemplateSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId String

  // Stable across template versions so "the same question" can be
  // compared between two inspections of one asset years apart, even
  // after the wording is revised. This is what recurring-defect
  // detection keys on — never the row id, which changes on republish.
  code String

  prompt    String
  helpText  String?
  type      QuestionType @default(PASS_FAIL_NA)
  sortOrder Int          @default(0)

  required Boolean @default(true)

  // Options for the select/dropdown types, ignored by the others.
  options String[]

  // Unit shown beside a MEASUREMENT answer ("mm", "N", "s"). Recorded so
  // a number in a report is never unitless.
  unit String?

  // Evidence policy. requirePhoto forces one before the inspection can
  // be completed; recommendPhoto only prompts. Both are honoured by the
  // engine, not by the form component, so the rule holds on the server.
  requirePhoto   Boolean @default(false)
  recommendPhoto Boolean @default(false)

  // Shows this question only when another question in the same template
  // holds a given answer. Shape:
  //   { "questionCode": "ASSET_HAS_MOTOR", "equals": ["YES"] }
  // Null means always shown.
  showWhen Json?

  rules      QuestionRule[]
  references QuestionComplianceReference[]
  answers    InspectionAnswer[]

  @@unique([sectionId, code])
  @@index([sectionId])
}

// The configurable half of the failure logic (brief §12). A rule fires
// when a question is answered a particular way and says what should
// happen — flag it, how serious, whether to demand an explanation or a
// photo, what to recommend, what action to offer. Held as rows so the
// behaviour is editable in the template builder instead of scattered
// through components as `if (answer === 'NO')`.
model QuestionRule {
  id         String           @id @default(cuid())
  question   TemplateQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId String

  // Fires when the answer status matches, e.g. FAIL. Null matches any
  // status and is used with whenValue for the non-pass/fail types.
  whenStatus AnswerStatus?
  // Fires when the recorded value matches, for select/text answers.
  whenValue  String?

  severity             FindingSeverity @default(MEDIUM)
  flag                 Boolean         @default(true)
  requireNote          Boolean         @default(true)
  requirePhoto         Boolean         @default(false)
  // Offered to the technician as a starting point, never written into
  // the report unless they accept or edit it.
  recommendation       String?
  suggestedActionTitle String?

  createdAt DateTime @default(now())

  @@index([questionId])
}

// ---------------------------------------------------------------------
// Compliance references
//
// Regulatory material attached to a question, carrying its own
// provenance. Every field that says "how current is this" is required
// reading in the UI: a standard that was last reviewed three years ago
// is presented as exactly that, not as today's law. Nothing here
// concludes that a given answer is or is not lawful — that judgement
// needs a person, and the UI says so.
// ---------------------------------------------------------------------

model ComplianceReference {
  id String @id @default(cuid())

  // e.g. "AS/NZS 60335.2.95", "Work Health and Safety Regulation 2017"
  title  String
  clause String?

  // "NSW", "VIC", "CTH". Free text rather than an enum because the set
  // differs per instrument and inventing a closed list would quietly
  // drop the ones that do not fit.
  jurisdiction String

  edition       String?
  effectiveFrom DateTime?
  sourceName    String?
  sourceUrl     String?

  // When a person last checked this entry against the source. Rendered
  // beside every citation. Null means never verified, and is shown as
  // "not verified" rather than hidden.
  lastReviewedAt DateTime?
  reviewedBy     String?

  // Set when the entry needs professional or legal interpretation
  // before it can be relied on. Rendered as a caution beside the
  // citation.
  interpretationNote String?

  assetTypes AssetType[]

  // Optional link to a stored PDF of the instrument itself.
  document   Document? @relation(fields: [documentId], references: [id])
  documentId String?

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  questions QuestionComplianceReference[]

  @@index([jurisdiction])
}

model QuestionComplianceReference {
  id          String              @id @default(cuid())
  question    TemplateQuestion    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId  String
  reference   ComplianceReference @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  referenceId String
  note        String?

  @@unique([questionId, referenceId])
}

// ---------------------------------------------------------------------
// Inspections
// ---------------------------------------------------------------------

model Inspection {
  id             String       @id @default(cuid())
  reference      String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  client   Client @relation(fields: [clientId], references: [id])
  clientId String
  site     Site   @relation(fields: [siteId], references: [id])
  siteId   String
  asset    Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assetId  String

  template        InspectionTemplate @relation(fields: [templateId], references: [id])
  templateId      String
  // The template version this was carried out against. Stored, not
  // joined, so republishing a template never changes what an existing
  // report says was asked.
  templateVersion Int                @default(1)

  // Free text ("Preventative maintenance", "6-monthly service") rather
  // than an enum: companies name their own inspection rounds and a
  // closed list would force them into someone else's vocabulary.
  inspectionType String

  technician        User    @relation("InspectionTechnician", fields: [technicianId], references: [id])
  technicianId      String
  // Licence or qualification as the technician states it. Recorded as
  // supplied and labelled that way — Doorlink does not check it against
  // any register, and the report must not imply otherwise.
  technicianLicence String?

  // Optional link to the marketplace job this was carried out under.
  job   Job?    @relation(fields: [jobId], references: [id])
  jobId String?

  jobNumber    String?
  siteContact  String?
  contactPhone String?
  scheduledFor DateTime?
  startedAt    DateTime?
  submittedAt  DateTime?
  notes        String?

  status InspectionStatus  @default(DRAFT)
  // Derived by the engine from the answers, recomputed on submit rather
  // than typed in. Null until there is enough answered to derive one.
  result InspectionResult?

  // The technician's statement that the record reflects what they did.
  // Without it an inspection cannot leave AWAITING_REVIEW, because a
  // report nobody stands behind is worse than no report.
  reviewedAt      DateTime?
  reviewStatement String?
  customerAckName String?
  customerAckAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers        InspectionAnswer[]
  findings       InspectionFinding[]
  actions        CorrectiveAction[]
  evidence       InspectionEvidence[]
  reportVersions InspectionReportVersion[]
  statusEvents   InspectionStatusEvent[]

  @@index([organizationId, status])
  @@index([assetId, submittedAt])
  @@index([technicianId])
  @@index([clientId])
}

model InspectionAnswer {
  id           String           @id @default(cuid())
  inspection   Inspection       @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  inspectionId String
  question     TemplateQuestion @relation(fields: [questionId], references: [id])
  questionId   String

  // Copied from the question at answer time so an answer stays readable
  // against the template version it belongs to, and so recurring-defect
  // comparison has a stable key without a join.
  questionCode String

  status AnswerStatus?

  // The non-pass/fail payload. One column per shape rather than a single
  // Json blob so a number stays a number for comparison between
  // inspections.
  valueText    String?
  valueNumber  Float?
  valueDate    DateTime?
  valueChoices String[]

  note String?

  // Set by the engine when a rule fires. Kept on the answer as well as
  // on the finding so "was this flagged" survives a finding being
  // dismissed by a reviewer.
  flagged Boolean @default(false)

  answeredAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  evidence InspectionEvidence[]
  findings InspectionFinding[]

  @@unique([inspectionId, questionId])
  @@index([inspectionId])
  @@index([questionCode])
}

// A photo, video, signature or document captured against a specific
// question — never a loose pile attached to the inspection. The report
// prints the question beside the image because an untitled photo of a
// bracket tells the customer nothing.
//
// fileKey is required: a row exists only once a file is actually
// stored. src/lib/storage.ts has no working upload backend until
// Supabase Storage is configured, so the capture UI reports that
// plainly rather than creating rows that point at nothing.
model InspectionEvidence {
  id           String            @id @default(cuid())
  inspection   Inspection        @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  inspectionId String
  answer       InspectionAnswer? @relation(fields: [answerId], references: [id], onDelete: Cascade)
  answerId     String?

  kind          EvidenceKind @default(PHOTO)
  fileKey       String
  caption       String?
  mimeType      String?
  fileSizeBytes Int?

  // When and by whom, recorded at capture. Printed under the image in
  // the report so a photo can be placed in time.
  capturedAt   DateTime @default(now())
  capturedBy   User?    @relation("EvidenceCapturedBy", fields: [capturedById], references: [id])
  capturedById String?

  sortOrder Int @default(0)

  @@index([inspectionId])
  @@index([answerId])
}

// Something the inspection turned up that a person needs to read. Split
// from the answer because one failed answer can raise a finding that is
// later re-graded, dismissed with a reason, or carried forward — and
// none of that should overwrite what the technician originally recorded.
model InspectionFinding {
  id           String            @id @default(cuid())
  inspection   Inspection        @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  inspectionId String
  answer       InspectionAnswer? @relation(fields: [answerId], references: [id], onDelete: SetNull)
  answerId     String?

  questionCode   String?
  title          String
  // What the technician saw. An observed condition, stated plainly.
  observation    String?
  // What they suggest doing about it. Separate from the observation so
  // the report can show the difference between fact and advice.
  recommendation String?

  severity FindingSeverity @default(MEDIUM)

  // True when the engine raised it from a rule; false when the
  // technician added it by hand. Printed nowhere, used to explain the
  // finding's origin in the review step.
  ruleGenerated Boolean @default(false)

  dismissedAt     DateTime?
  dismissedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  actions CorrectiveAction[]

  @@index([inspectionId])
  @@index([severity])
}

model CorrectiveAction {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  inspection   Inspection?        @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  inspectionId String?
  finding      InspectionFinding? @relation(fields: [findingId], references: [id], onDelete: SetNull)
  findingId    String?
  // Kept even when the inspection is deleted: an outstanding action on a
  // piece of equipment outlives the visit that found it.
  asset        Asset              @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assetId      String

  title               String
  description         String?
  severity            FindingSeverity @default(MEDIUM)
  recommendedSolution String?

  status     ActionStatus @default(OPEN)
  assignee   User?        @relation("ActionAssignee", fields: [assigneeId], references: [id])
  assigneeId String?
  dueAt      DateTime?

  completedAt  DateTime?
  verifiedAt   DateTime?
  verifiedBy   User?     @relation("ActionVerifier", fields: [verifiedById], references: [id])
  verifiedById String?
  closingNote  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([assetId, status])
  @@index([assigneeId])
}

// An immutable snapshot of a generated report. Editing an inspection
// after issue produces V2 — it never rewrites V1, because the customer
// already has V1 and a document that silently changes under them is not
// a record of anything (brief §32).
model InspectionReportVersion {
  id           String     @id @default(cuid())
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  inspectionId String

  version Int

  // The full rendered content at issue time: answers, findings, actions,
  // evidence keys, the profile and template wording as they then stood.
  // Frozen, so the report does not re-derive itself from rows that have
  // since moved on.
  payload Json

  result InspectionResult

  generatedAt     DateTime @default(now())
  generatedBy     User?    @relation("ReportGeneratedBy", fields: [generatedById], references: [id])
  generatedById   String?
  supersedeReason String?

  @@unique([inspectionId, version])
  @@index([inspectionId])
}

// Append-only lifecycle history, the same pattern as JobStatusEvent:
// "who moved this to completed, and when" answered from data rather
// than inferred from timestamps.
model InspectionStatusEvent {
  id           String            @id @default(cuid())
  inspection   Inspection        @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  inspectionId String
  fromStatus   InspectionStatus?
  toStatus     InspectionStatus
  actor        User?             @relation("InspectionStatusActor", fields: [actorId], references: [id])
  actorId      String?
  note         String?
  createdAt    DateTime          @default(now())

  @@index([inspectionId])
}

// ---------------------------------------------------------------------
// Community manual submissions
// ---------------------------------------------------------------------
//
// A submission is deliberately NOT a Document. Everything that reads the
// published library reads Document, so an unapproved upload living there
// — even with isPublished false — would be one forgotten `where` clause
// away from being served. Keeping them in a separate table means the
// default state of a submission is invisible, and publishing is an
// explicit act that creates a Document row.

enum SubmissionStatus {
  // Uploaded, nothing has looked at it yet.
  RECEIVED
  // Sent to the AI check; a result has not come back.
  CHECKING
  // The AI check finished. Which of these it lands on is decided by
  // `decideStatus`, never by the model itself — the model reports what
  // it saw and the policy decides what that means.
  AWAITING_REVIEW
  FLAGGED
  POSSIBLE_DUPLICATE
  // An admin asked the submitter for something.
  INFO_REQUESTED
  // Terminal states. APPROVED is the only one that has a Document.
  APPROVED
  REJECTED
  WITHDRAWN
}

// What the AI check reported. Separate from SubmissionStatus because
// "the model thinks this is fine" and "this is ready for a human" are
// different facts, and collapsing them is how a model ends up publishing
// things on its own.
enum AiVerdict {
  // No check ran — no AI provider configured, or the file could not be
  // read. NOT the same as a check that found nothing wrong.
  NOT_RUN
  VERIFIED
  NEEDS_REVIEW
  REJECTED
  POSSIBLE_DUPLICATE
  // The check was attempted and failed (timeout, API error). Recorded so
  // a failed check is never mistaken for a clean one.
  ERRORED
}

// Whether the file was scanned for malware. There is no scanning service
// connected, so the honest answer today is UNAVAILABLE on every row —
// which is exactly why this is stored rather than assumed.
enum ScanState {
  UNAVAILABLE
  PENDING
  CLEAN
  INFECTED
}

model ManualSubmission {
  id        String @id @default(cuid())
  // Human-readable, for talking to a submitter about their upload.
  reference String @unique

  submittedBy   User   @relation("SubmittedManuals", fields: [submittedById], references: [id], onDelete: Cascade)
  submittedById String

  // Free text, not a Manufacturer relation. The point of the feature is
  // manuals Doorlink does not have, which routinely means manufacturers
  // it does not have either. Linking happens at approval, not upload.
  manufacturerName String
  productName      String
  modelCode        String
  categorySlug     String
  // Optional because the brief is explicit that a submitter must not be
  // forced to supply what they cannot reasonably know.
  serialNumber     String?
  year             Int?
  description      String?

  // Null until the file reaches storage. A submission row with no
  // fileKey is a record of an attempt that could not be stored, which is
  // worth keeping rather than silently dropping.
  fileKey          String?
  originalFilename String
  mimeType         String
  fileSizeBytes    Int
  // SHA-256 of the bytes. The first and cheapest duplicate check.
  sha256           String

  status SubmissionStatus @default(RECEIVED)

  aiVerdict    AiVerdict @default(NOT_RUN)
  // 0-100. Null when no check ran — a missing confidence and a
  // confidence of zero mean different things.
  aiConfidence Int?
  aiReasoning  String?
  aiCheckedAt  DateTime?
  // Which model produced the verdict, so an old verdict can be told
  // apart from one made by current software.
  aiModel      String?

  scanState ScanState @default(UNAVAILABLE)

  // Set when the file or its metadata matches something already public.
  duplicateOf   Document? @relation("SubmissionDuplicate", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicateOfId String?

  reviewedBy   User?     @relation("ReviewedManuals", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?

  // The Document created on approval. Null for everything else.
  publishedDocument   Document? @relation("SubmissionPublished", fields: [publishedDocumentId], references: [id], onDelete: SetNull)
  publishedDocumentId String?   @unique

  events ManualSubmissionEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([status])
  @@index([submittedById])
  @@index([sha256])
}

// Append-only history. Who did what to a submission and when, including
// what the AI said, so a published manual can always be traced back to
// the decision that let it through.
model ManualSubmissionEvent {
  id           String           @id @default(cuid())
  submission   ManualSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionId String

  from SubmissionStatus?
  to   SubmissionStatus
  note String?

  // Null for events the system raised itself.
  actor   User?   @relation("ManualSubmissionEvents", fields: [actorId], references: [id], onDelete: SetNull)
  actorId String?

  createdAt DateTime @default(now())

  @@index([submissionId])
}

// ---------------------------------------------------------------------
// Spring calculator
// ---------------------------------------------------------------------

enum SpringSystemType {
  TORSION
  EXTENSION
}

enum SpringCalcMethod {
  DOOR_WEIGHT
  EXISTING_SPRING
  EXTENSION
}

// A saved spring calculation, optionally pinned to an asset.
//
// Deliberately stores the *inputs* alongside the result rather than the
// result alone. A number on its own ages badly: six months later nobody
// can tell whether 24.2 came from a weighed door or a guessed one. The
// warnings are stored for the same reason — a result that was flagged at
// the time should still look flagged when it is read back.
model SpringCalculation {
  id        String @id @default(cuid())
  reference String @unique

  // Who ran it. Kept even if the asset link is later cleared, because
  // the audit question is "who calculated this", not "what was it for".
  performedBy   User   @relation("SpringCalculations", fields: [performedById], references: [id], onDelete: Cascade)
  performedById String

  // Optional: the calculator is a public tool and most runs are not
  // against a recorded asset. Saving to one is an extra a signed-in
  // technician with an organisation can do.
  asset     Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)
  assetId   String?
  // Free text when there is no Asset row to point at.
  doorLabel String?

  springType SpringSystemType
  method     SpringCalcMethod

  // Inputs, stored in the calculator's internal units (pounds, inches)
  // so a stored row means one thing regardless of which toggle the
  // person was using when they typed it.
  doorWeightLb     Float?
  doorHeightIn     Float?
  drumDiameterIn   Float?
  wireDiameterIn   Float?
  insideDiameterIn Float?
  bodyLengthIn     Float?
  springCount      Int
  liftType         String?
  preloadTurns     Float?

  // Results.
  ipptPerSpring   Float?
  turns           Float?
  pullPerSpringLb Float?
  lifeYears       Float?

  // Warning codes and messages as shown at the time.
  warnings Json?

  createdAt DateTime @default(now())

  @@index([performedById])
  @@index([assetId])
}
